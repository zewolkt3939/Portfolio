{$SITE_ADDRESS} {
    encode zstd gzip
    @dynamic path /admin* /api* /health/* /research.html /research/* /vi/research.html /vi/research/* /sitemap.xml /feed.xml /vi/feed.xml /robots.txt
    handle_path /assets/uploads/* {
        root * /srv/uploads
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle @dynamic {
        reverse_proxy app:8000
    }
    handle {
        root * /srv/site
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://{$ANALYTICS_ADDRESS}; font-src 'self'; connect-src 'self' https://{$ANALYTICS_ADDRESS}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }
}

{$WWW_ADDRESS} {
    redir https://{$SITE_ADDRESS}{uri} permanent
}

{$ANALYTICS_ADDRESS} {
    encode zstd gzip
    reverse_proxy umami:3000
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
    }
}
