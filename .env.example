# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-postgres-admin-password
POSTGRES_DB=postgres
POSTGRES_USER=postgres
PORTFOLIO_DB_PASSWORD=replace-with-portfolio-role-password
UMAMI_DB_PASSWORD=replace-with-another-long-random-password
DATABASE_URL=postgresql+psycopg://portfolio:${PORTFOLIO_DB_PASSWORD}@postgres:5432/portfolio
APP_SECRET_KEY=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-output-of-portfolio-cms-fernet-key
PUBLIC_BASE_URL=https://example.com
SITE_ADDRESS=example.com
WWW_ADDRESS=www.example.com
ANALYTICS_ADDRESS=analytics.example.com
ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
ANALYTICS_WEBSITE_ID=
NOTION_API_TOKEN=
NOTION_API_VERSION=2026-03-11
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=true
UPLOAD_DIR=/data/uploads
UMAMI_APP_SECRET=replace-with-a-long-random-password
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-32-byte-base64-value
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.3.1@sha256:fa32d116cf20cad52cbc3fad9a63b46e7fa02299d8f967168eb453d49c476b4a

# Encrypted off-site Restic repository. This example uses Amazon S3 in Singapore.
# Keep the bucket private; replace the globally unique bucket name.
RESTIC_REPOSITORY=s3:s3.ap-southeast-1.amazonaws.com/replace-with-unique-bucket-name/portfolio-restic
RESTIC_PASSWORD=replace-with-a-long-random-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
